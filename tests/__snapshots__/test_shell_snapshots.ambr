# serializer version: 1
# name: test_render_all_snapshot[bash]
  '''
  alias bsg='echo hello\'
  alias envg='echo $HOME %USERPROFILE%'
  gco() {
      qwik run "gco" "$@"
  }
  alias gs='git status'
  alias lsg='echo '"'"'hello world'"'"''
  '''
# ---
# name: test_render_all_snapshot[cmd]
  '''
  REM qwik cmd hook (best-effort; template aliases omitted)
  doskey bsg=echo hello\ $*
  doskey envg=echo $HOME %USERPROFILE% $*
  REM omitted gco: template mode unsupported in cmd
  doskey gs=git status $*
  doskey lsg=echo 'hello world' $*
  '''
# ---
# name: test_render_all_snapshot[fish]
  '''
  function bsg
      'echo hello\\' $argv
  end
  function envg
      'echo $HOME %USERPROFILE%' $argv
  end
  function gco
      qwik run "gco" $argv
  end
  function gs
      'git status' $argv
  end
  function lsg
      'echo \'hello world\'' $argv
  end
  '''
# ---
# name: test_render_all_snapshot[nu]
  '''
  def bsg [...args] {
      ^echo hello\ ...$args
  }
  def envg [...args] {
      ^echo $HOME %USERPROFILE% ...$args
  }
  def gco [...args] {
      qwik run "gco" ...$args
  }
  def gs [...args] {
      ^git status ...$args
  }
  def lsg [...args] {
      ^echo 'hello world' ...$args
  }
  '''
# ---
# name: test_render_all_snapshot[pwsh]
  '''
  function bsg {
      echo hello\ @args
  }
  function envg {
      echo $HOME %USERPROFILE% @args
  }
  function gco {
      qwik run "gco" @args
  }
  function gs {
      git status @args
  }
  function lsg {
      echo 'hello world' @args
  }
  '''
# ---
# name: test_render_all_snapshot[xonsh]
  '''
  aliases["bsg"] = "echo hello\\"
  aliases["envg"] = "echo $HOME %USERPROFILE%"
  def gco(*args):
      qwik run("gco", *args)
  aliases["gs"] = "git status"
  aliases["lsg"] = "echo 'hello world'"
  '''
# ---
# name: test_render_all_snapshot[zsh]
  '''
  alias bsg='echo hello\'
  alias envg='echo $HOME %USERPROFILE%'
  gco() {
      qwik run "gco" "$@"
  }
  alias gs='git status'
  alias lsg='echo '"'"'hello world'"'"''
  '''
